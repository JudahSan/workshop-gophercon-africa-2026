package layout

type BaseProps struct {
	Title string
}

templ Base(props BaseProps) {
	<!DOCTYPE html>
	<html lang="en-GB">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ props.Title }</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/assets/css/app.css"/>
		</head>
		<body>
			<div class="crt-overlay" aria-hidden="true" id="crt-overlay"></div>
			<div class="scanlines" aria-hidden="true" id="scanlines"></div>
			<canvas id="confetti-canvas" class="confetti-canvas" aria-hidden="true"></canvas>
			<main class="container">
				{ children... }
			</main>
			<script src="/assets/js/app.js"></script>
		</body>
	</html>
}
